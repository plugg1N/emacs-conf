; LR3 - реализация программы. Вариант номер 8
; Шифр задания: 2.3.8
; f2 = -(4i+3) if a > b, else 6i-10
; f3 = 7-4i if a > b, else 8-6i
; f8 = |i2|-|i1| if k < 0 else max(4, |i2|-3)

; Стек  программы
AStack    SEGMENT  STACK
          DW 12 DUP(?)
AStack    ENDS

; Данные программы
DATA      SEGMENT

; Значения для теста 1 (другие тесты — заменой этих четырёх констант)
a       DW    5
b       DW    4
i       DW    1
k       DW    -4

i1      DW    ?
i2      DW    ?
res     DW    4        ; заготовка для max(4,...)

DATA      ENDS

; Код программы
CODE      SEGMENT
          ASSUME CS:CODE, DS:DATA, SS:AStack

; Головная процедура
Main      PROC  NEAR     ; начало процедуры
          mov   ax,data  ; загрузка DS в AX
          mov   ds,ax    ; адрес начала сегмента данных

;         ===== Вычислительная часть =====
;         Вычисление 2i и 4i
          mov   cx,i     ; CX = i
          shl   cx,1     ; CX = 2i
          mov   dx,cx    ; DX = 2i
          shl   cx,1     ; CX = 4i

;         a > b ?
          mov   ax,a     ; AX = a
          CMP   ax,b     ; a ? b
          JG    A_bigger_B

;         Если a <= b
;         i1 = 6i - 10
          add   cx,dx    ; CX = 4i + 2i = 6i
          sub   cx,10    ; CX = 6i - 10 = i1
;         i2 = 8 - 6i = -(i1 + 2)
          mov   bx,cx    ; BX = i1
          add   bx,2     ; BX = i1 + 2
          NEG   bx       ; BX = -(i1 + 2) = i2

          JMP   NEXT

;         Если a > b
A_bigger_B:
;         i1 = -(4i + 3)
          add   cx,3     ; CX = 4i + 3
          NEG   cx       ; CX = -(4i + 3) = i1
;         i2 = 7 - 4i = i1 + 10
          mov   bx,cx    ; BX = i1
          add   bx,10    ; BX = i1 + 10 = i2

NEXT:
;         Сохранение i1 и i2 и вычисление |i2|
          mov   i1,cx    ; i1 = CX
          mov   i2,bx    ; i2 = BX

          CMP   bx,0     ; i2 ? 0
          JGE   i2_POS   ; i2 >= 0 => |i2| = i2v
          NEG   bx       ; i2 < 0 => BX = |i2|
i2_POS:

;         k < 0 ?
          CMP   k,0      ; k ? 0
          JL    k_NEG

;         Если k >= 0: res = max(4, |i2| - 3)
          sub   bx,3     ; BX = |i2| - 3
          CMP   bx,4     ; |i2| - 3 ? 4
          JLE   return_dos ; |i2| - 3 <= 4 => res = 4
          mov   res,bx   ; |i2| - 3 > 4  => res = |i2| - 3
          JMP   return_dos

;         Если k < 0: res = |i2| - |i1|
k_NEG:
          CMP   cx,0     ; i1 ? 0
          JGE   i1_POS   ; i1 >= 0 => |i1| = i1
          NEG   cx       ; i1 < 0 => CX = |i1|
i1_POS:
          sub   bx,cx    ; BX = |i2| - |i1|
          mov   res,bx   ; res = |i2| - |i1|
;         ===== Конец вычислительной части (34 команды) =====

return_dos:
          mov   ah,4ch   ; загрузка значения для выхода в dos
          int   21h      ; выход в dos

Main      ENDP
CODE      ENDS
          END Main
