f = open("9_27621.csv", "r").read()
data = []
r = f.strip().split()
k = 1

for i in r:
    data.append(list(map(int, i.split(','))))

for row in data:
    counts = [row.count(i) for i in row]

    ma = max(row)
    mi = min(row)

    x = ma - mi
    ost = sum(row) - ma - mi

    if counts.count(1) == 5 and x == ost:
        print(k)
        break

    k += 1

